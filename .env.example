# .env.example — placeholders ONLY. No real secrets.
# Copy to .env and fill values locally; never commit the real .env.

# --- Runtime ---
IOMT_ENV=dev
LOG_LEVEL=info

# --- Edge-lite (Pi 3B+) ---
EDGE_CONFIG=./config/edge.default.yaml
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME

# --- Cloud backend (PostgreSQL / TimescaleDB) ---
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/iomt
API_BIND=0.0.0.0:8080

# --- Object storage / model registry ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# --- Mobile (dev only) ---
API_BASE_URL=http://localhost:8080/api/v1

# --- Signing (dev placeholders; real keys via secrets manager) ---
MODEL_SIGNING_PUBKEY_PATH=CHANGE_ME
