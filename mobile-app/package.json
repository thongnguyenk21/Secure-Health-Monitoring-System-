{
  "name": "iomt-mobile-app",
  "version": "0.1.0",
  "private": true,
  "description": "Patient mobile app of the Secure Health Monitoring IoMT system (Android).",
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 19006",
    "android": "expo start --android",
    "build:web": "expo export --platform web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "gen:api": "openapi-typescript ../shared/protocols/openapi/cloud-api.openapi.yaml -o src/api/schema.d.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.{ts,tsx}"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|@tanstack/.*)"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "0.4.1",
    "@expo-google-fonts/source-sans-3": "0.4.2",
    "@expo/metro-runtime": "58.0.14",
    "@tanstack/react-query": "5.104.3",
    "expo": "58.0.11",
    "expo-constants": "58.0.12",
    "expo-font": "58.0.8",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.20",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.9",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsdoc": "61.7.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "globals": "16.5.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "openapi-typescript": "7.13.0",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "expo-modules-core": {
      "react-native-worklets": "0.13.0"
    }
  }
}
