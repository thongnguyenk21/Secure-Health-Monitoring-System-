# ---- Rust ----
target/
**/*.rs.bk

# ---- Python (uv) ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- Node / React Native ----
node_modules/
mobile-app/android/build/
mobile-app/android/.gradle/
mobile-app/android/app/build/
mobile-app/ios/Pods/
mobile-app/ios/build/
*.apk
*.aab
*.ipa

# ---- ESP-IDF / firmware build output ----
iot-node/firmware/build/
iot-node/firmware/.embuild/
iot-node/firmware/sdkconfig
sdkconfig.old

# ---- Environment and secrets (never commit real values) ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.dec.*
google-services.json
GoogleService-Info.plist

# ---- ML training output (NOT the signed model artifacts under iot-node/firmware/models) ----
checkpoints/
runs/
wandb/
experiments/logs/*
!experiments/logs/.gitkeep
benchmarks/results/*
!benchmarks/results/.gitkeep


# ---- OS / editors ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
